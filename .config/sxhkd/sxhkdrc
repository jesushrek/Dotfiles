# HotKeys

# All of the variables are defined in ~/.xinitrc.

# Terminal
super + Return
	"${xterm}"

# Dmenu
super + d
	dmenu_run -p "Select: " -m 0

# Browser
super + semicolon
	"${browser}"

# Clipboard
super + v 
	"${clipboard}"

# Bookmarks
ctrl + shift + space
	"${HOME}/scripts/bookmarks.sh"

# Special script
XF86Launch2
	"${HOME}/scripts/fart.sh"

# Screen lock
super + shift + l
	"${lock}"

# Emoji
ctrl + shift + period
	"${HOME}/scripts/emoji.sh"

# Screenshot
Print
	flameshot gui

super + Print
	flameshot full -c -p "${picture_dir}/Screenshots"

# Audio controls
XF86AudioPlay
	playerctl play-pause

XF86AudioNext
	playerctl next

XF86AudioPrev
	playerctl previous

XF86AudioLowerVolume
	/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

XF86AudioRaiseVolume
	/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

XF86AudioMute
	/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness Control
XF86MonBrightnessUp
	/usr/bin/brillo -q -A 5

XF86MonBrightnessDown
	/usr/bin/brillo -q -U 5
