# HotKeys


super + Return
	"${xterm}"

super + d
	dmenu_run -p "Select: " -m 0

super + semicolon
	"${browser}"

super + v 
	"${clipboard}"

ctrl + shift + space
	"${HOME}/scripts/bookmarks.sh"

XF86Launch2
	"${HOME}/scripts/fart.sh"

super + shift + l
	"${lock}"

Print
	flameshot gui

super + Print
	flameshot full -c -p "${picture_dir}/Screenshots"

XF86AudioPlay
	playerctl play-pause

XF86AudioNext
	playerctl next

XF86AudioPrev
	playerctl previous

XF86AudioLowerVolume
	/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

XF86AudioRaiseVolume
	/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

XF86AudioMute
	/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86MonBrightnessUp
	/usr/bin/brillo -q -A 5

XF86MonBrightnessDown
	/usr/bin/brillo -q -U 5
