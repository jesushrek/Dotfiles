# HotKeys

# All of the variables are defined in ~/.xinitrc.

# Reload Hotkeys
super + Escape
	pkill -USR1 -x sxhkd

# Get Info
super + shift + grave
	"${scripts}/notification.sh"

# Terminal
super + Return
	"${xterm}"

# Dmenu
super + d
	dmenu_run -p "Select: " -m 0

# Browser
super + semicolon
	"${browser}"

# Clipboard
super + v 
	"${clipboard}"

# Bookmarks
ctrl + shift + space
	"${scripts}/bookmarks.sh"

# Special script
XF86Launch2
	"${scripts}/fart.sh"

# Screen lock
super + shift + l
	"${lock}"

# Emoji
ctrl + shift + period
	"${scripts}/emoji.sh"

# Screenshot
Print
	flameshot gui

super + Print
	flameshot full -c -p "${picture_dir}/Screenshots"

# Audio controls
XF86AudioPlay
	playerctl play-pause

XF86AudioNext
	playerctl next

XF86AudioPrev
	playerctl previous

XF86AudioLowerVolume
	/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- ; "${scripts}/notification.sh"

XF86AudioRaiseVolume
	/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ ; "${scripts}/notification.sh"

XF86AudioMute
	/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ; "${scripts}/notification.sh"

# Brightness Control
XF86MonBrightnessUp
	/usr/bin/brillo -q -A 1 ; "${scripts}/notification.sh"

XF86MonBrightnessDown
	/usr/bin/brillo -q -U 1 ; "${scripts}/notification.sh"
